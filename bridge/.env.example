# Generate a private value. It stays on this computer; never put it in an app build.
BRIDGE_TOKEN=replace-with-at-least-32-base64url-characters

# Optional phone pairing exchange for the T3 app. Remove it to disable pairing.
# BRIDGE_PASSPHRASE=replace-with-a-private-passphrase

# A T3 bearer access token with orchestration:read and orchestration:operate.
T3_ACCESS_TOKEN=replace-with-t3-bearer-token
T3_BASE_URL=http://127.0.0.1:3773

# Local whisper.cpp endpoint. `npm run start:t3` sets a private random path itself.
# Set this only when you run whisper-server separately.
# WHISPER_SERVER_URL=http://127.0.0.1:8178/even-t3/inference
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.en.bin
# WHISPER_LANGUAGE=en
# WHISPER_PARTIAL_INTERVAL_MS=2000
# WHISPER_TRANSCRIPTION_TIMEOUT_MS=60000

# The listener must be loopback. See README.md for Tailscale Serve.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Optional hardening and behavior controls.
# BRIDGE_PROJECT_IDS=project-uuid-1,project-uuid-2
# Legacy compatibility only: new sessions always use full-access.
# BRIDGE_RUNTIME_MODE=approval-required
# BRIDGE_POLL_INTERVAL_MS=1000
# BRIDGE_RATE_LIMIT_PER_MINUTE=120
# Optional glasses tools for one T3 project.
# BRIDGE_FACECLAW_PROJECT_ID=your-general-assistant-project-id
# Absolute installed Codex CLI path; enables on-demand gpt-5.6-luna/low refinement.
# BRIDGE_REFINEMENT_CODEX_PATH=/absolute/path/to/codex
# Optional Signal service (requires both absolute paths; no existing account directory).
# BRIDGE_SIGNAL_CLI_PATH=/absolute/path/to/signal-cli-0.14.7/bin/signal-cli
# BRIDGE_SIGNAL_DATA_DIR=/absolute/private/path/to/faceclaw-signal-data
# JAVA_HOME=/absolute/path/to/Java25/Home
